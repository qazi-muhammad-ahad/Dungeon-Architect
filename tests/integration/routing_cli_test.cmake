function(run expected)
  execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${code}" STREQUAL "${expected}")
    message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${code}\n${out}\n${err}")
  endif()
  set(last_output "${out}" PARENT_SCOPE)
endfunction()
foreach(name straight-width2 hole-detour-width2 narrow-neck-width1)
  set(file "${DATASETS}/${name}.json")
  file(SHA256 "${file}" before)
  run(0 route "${file}" --json --events 4)
  set(first "${last_output}")
  string(JSON connected GET "${first}" geometry connected_floor_verified)
  string(JSON count LENGTH "${first}" geometry rooms)
  string(JSON capacity GET "${first}" geometry rooms 0 capacity)
  string(JSON event_count LENGTH "${first}" events)
  if(NOT connected OR NOT count EQUAL 2 OR NOT capacity EQUAL 0 OR event_count GREATER 4)
    message(FATAL_ERROR "Missing connected floor, exact rooms, safe entrance, or trace bound")
  endif()
  run(0 route "${file}" --json --events 4)
  if(NOT first STREQUAL last_output)
    message(FATAL_ERROR "Routed geometry is not byte reproducible")
  endif()
  file(SHA256 "${file}" after)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "Routing modified its input")
  endif()
endforeach()
run(0 route "${DATASETS}/straight-width2.json" --events 0)
if(NOT last_output MATCHES "Connected dungeon: 2 rooms, 1 corridors, width 2" OR NOT last_output MATCHES "56")
  message(FATAL_ERROR "Human output omitted verified geometry summary")
endif()
foreach(name narrow-neck-width2 blocked-doors)
  run(7 route "${DATASETS}/${name}.json" --json)
  string(JSON type TYPE "${last_output}" geometry)
  if(NOT type STREQUAL "NULL")
    message(FATAL_ERROR "Failed routing exposed partial geometry")
  endif()
endforeach()
run(2 route "${DATASETS}/invalid-capacity.json" --json)
string(JSON code GET "${last_output}" diagnostics 0 code)
if(NOT code STREQUAL "capacity_exceeds_spawns")
  message(FATAL_ERROR "Impossible override was not rejected")
endif()
run(0 route "${DATASETS}/../generation/standard-150.json" --json --events 0)
string(JSON count LENGTH "${last_output}" geometry rooms)
if(NOT count EQUAL 16)
  message(FATAL_ERROR "Standard 150x150 case lost rooms")
endif()
message(STATUS "Routing CLI clearance, reproducibility, source preservation, and 150x150 example passed")
