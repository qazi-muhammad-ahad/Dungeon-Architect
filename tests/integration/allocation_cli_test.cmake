function(run expected)
  execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${code}" STREQUAL "${expected}")
    message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${code}\n${out}\n${err}")
  endif()
  set(last_output "${out}" PARENT_SCOPE)
endfunction()
foreach(name teaching zero-budget standard-14)
  set(file "${DATASETS}/${name}.json")
  file(SHA256 "${file}" before)
  run(0 optimize "${file}" --json --events 4)
  set(first "${last_output}")
  string(JSON optimal GET "${first}" optimal)
  string(JSON count LENGTH "${first}" events)
  if(NOT optimal OR count GREATER 4)
    message(FATAL_ERROR "Missing exact optimum or trace bound")
  endif()
  run(0 optimize "${file}" --json --events 4)
  if(NOT first STREQUAL last_output)
    message(FATAL_ERROR "Allocation is not byte reproducible")
  endif()
  file(SHA256 "${file}" after)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "Optimization modified source input")
  endif()
endforeach()
run(0 optimize "${DATASETS}/teaching.json" --json --detailed-trace)
string(JSON score GET "${last_output}" allocation total_score)
string(JSON actors LENGTH "${last_output}" allocation actors)
if(NOT score EQUAL 14 OR NOT actors EQUAL 3)
  message(FATAL_ERROR "Teaching optimum/placement is wrong")
endif()
run(0 optimize "${DATASETS}/teaching.json" --json --budget 2)
string(JSON score GET "${last_output}" allocation total_score)
if(NOT score EQUAL 9)
  message(FATAL_ERROR "Budget edit did not change optimum")
endif()
run(0 optimize "${DATASETS}/zero-budget.json" --json)
string(JSON score GET "${last_output}" allocation total_score)
string(JSON threat GET "${last_output}" allocation total_threat)
if(NOT score EQUAL 5 OR NOT threat EQUAL 0)
  message(FATAL_ERROR "Zero-threat pack was not selected at zero budget")
endif()
run(0 optimize "${DATASETS}/teaching.json")
if(NOT last_output MATCHES "Exact optimum.*score 14" OR NOT last_output MATCHES "oversized" OR NOT last_output MATCHES "no_compatible_eligible_room")
  message(FATAL_ERROR "Missing human summary and unused explanations")
endif()
run(3 optimize "${DATASETS}/unsupported-15.json" --json)
string(JSON code GET "${last_output}" diagnostics 0 code)
if(NOT code STREQUAL "active_pack_limit")
  message(FATAL_ERROR "Active pack limit was not enforced")
endif()
run(5 optimize "${DATASETS}/standard-14.json" --json --work 10000000 --events 0)
string(JSON code GET "${last_output}" diagnostics 0 code)
string(JSON kind TYPE "${last_output}" allocation)
string(JSON optimal GET "${last_output}" optimal)
if(NOT code STREQUAL "allocation_work_estimate" OR NOT kind STREQUAL "NULL" OR optimal)
  message(FATAL_ERROR "Resource rejection exposed a partial optimum")
endif()
run(3 optimize "${DATASETS}/standard-14.json" --json --detailed-trace)
run(64 optimize "${DATASETS}/teaching.json" --budget -1)
run(64 route "${DATASETS}/teaching.json" --detailed-trace)
message(STATUS "Exact allocation CLI optimum, failures, deterministic replay, and source preservation passed")
