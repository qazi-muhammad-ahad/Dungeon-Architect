if(NOT DEFINED CLI OR NOT DEFINED FIXTURE OR NOT DEFINED TEST_DIR)
  message(FATAL_ERROR "CLI, FIXTURE, and TEST_DIR are required")
endif()
# Unique directory created by this test; no deletion of preexisting directories.
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(scratch "${TEST_DIR}/cli-${suffix}")
file(MAKE_DIRECTORY "${scratch}")

function(run expected)
  execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${code}" STREQUAL "${expected}")
    message(FATAL_ERROR "Command ${ARGN}: expected ${expected}, got ${code}\n${out}\n${err}")
  endif()
  set(last_output "${out}" PARENT_SCOPE)
  set(last_error "${err}" PARENT_SCOPE)
endfunction()

run(0 new "${scratch}/new project.json" --name "CLI project" --seed 4294967295 --json)
string(JSON outcome GET "${last_output}" outcome)
if(NOT outcome STREQUAL "success" OR NOT last_error STREQUAL "")
  message(FATAL_ERROR "New did not produce a clean machine-readable success")
endif()
run(0 inspect "${scratch}/new project.json" --json)
string(JSON seed GET "${last_output}" source settings seed)
string(JSON name GET "${last_output}" source name)
if(NOT seed STREQUAL "4294967295" OR NOT name STREQUAL "CLI project")
  message(FATAL_ERROR "CLI seed/name were not preserved")
endif()
file(SHA256 "${scratch}/new project.json" before)
run(4 new "${scratch}/new project.json")
file(SHA256 "${scratch}/new project.json" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Refused overwrite changed the file")
endif()
run(0 validate "${FIXTURE}" --json --for-allocation)
run(0 save "${FIXTURE}" "${scratch}/canonical.json")
run(0 save "${scratch}/canonical.json" "${scratch}/round trip.json")
file(SHA256 "${scratch}/canonical.json" canonical)
file(SHA256 "${scratch}/round trip.json" roundtrip)
if(NOT canonical STREQUAL roundtrip)
  message(FATAL_ERROR "Canonical CLI round trip changed bytes")
endif()
run(0 new "${scratch}/canonical.json" --force)
file(WRITE "${scratch}/invalid.json" "{bad")
run(2 validate "${scratch}/invalid.json" --json)
string(JSON outcome GET "${last_output}" outcome)
if(NOT outcome STREQUAL "invalid_input" OR NOT last_error STREQUAL "")
  message(FATAL_ERROR "Malformed input did not produce a clean JSON error")
endif()
run(4 inspect "${scratch}/missing.json" --json)
run(64 new "${scratch}/not created.json" --seed -1)
run(64 validate "${FIXTURE}" --force)
run(64 unknown-command)
# Remove only named files produced by this test. Leave empty test directory.
file(REMOVE "${scratch}/new project.json" "${scratch}/canonical.json"
  "${scratch}/round trip.json" "${scratch}/invalid.json")
message(STATUS "CLI create/inspect/validate/save/error contracts passed")
