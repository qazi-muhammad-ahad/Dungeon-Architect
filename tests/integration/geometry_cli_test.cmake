if(NOT DEFINED CLI OR NOT DEFINED DATASETS OR NOT DEFINED TEST_DIR)
  message(FATAL_ERROR "CLI, DATASETS, and TEST_DIR are required")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(scratch "${TEST_DIR}/geometry-cli-${suffix}")
file(MAKE_DIRECTORY "${scratch}")
function(run expected)
  execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${code}" STREQUAL "${expected}")
    message(FATAL_ERROR "Command ${ARGN}: expected ${expected}, got ${code}\n${out}\n${err}")
  endif()
  set(last_output "${out}" PARENT_SCOPE)
  set(last_error "${err}" PARENT_SCOPE)
endfunction()
foreach(name holes islands narrow-neck boundary-touching)
  run(0 validate "${DATASETS}/${name}.json" --for-generation --json)
endforeach()
foreach(name boundary-conflict fixed-overlap fixed-islands)
  run(2 validate "${DATASETS}/${name}.json" --for-generation --json)
  string(JSON count LENGTH "${last_output}" diagnostics)
  if(count LESS 1 OR NOT last_error STREQUAL "")
    message(FATAL_ERROR "Expected clean JSON diagnostics for ${name}")
  endif()
endforeach()
run(0 mask-info "${DATASETS}/islands.json" --json)
string(JSON components LENGTH "${last_output}" components)
string(JSON detached GET "${last_output}" components 1 detached)
if(NOT components EQUAL 2 OR NOT detached)
  message(FATAL_ERROR "Detached island was not highlighted")
endif()
run(0 mask-info "${DATASETS}/fixed-islands.json" --json)
string(JSON outcome GET "${last_output}" generation_preflight outcome)
if(NOT outcome STREQUAL "invalid_input")
  message(FATAL_ERROR "Inspection omitted the failed generation preflight")
endif()
run(0 mask-info "${DATASETS}/holes.json")
if(NOT last_output MATCHES "Locked rooms: 2; rooms still required: 2" OR NOT last_output MATCHES "R")
  message(FATAL_ERROR "ASCII reservation preview missing")
endif()
run(0 mask "${DATASETS}/islands.json" "${scratch}/mask.json" rectangle 0 0 12 10 --json)
run(0 mask "${scratch}/mask.json" "${scratch}/ellipse.json" ellipse 0 0 12 10)
run(0 mask "${scratch}/mask.json" "${scratch}/l-shape.json" l-shape 0 0 12 10)
run(0 room-add "${scratch}/mask.json" "${scratch}/room.json" entry 1 1 2 2 --role entrance --locked --name "Safe entrance" --json)
run(0 room-set "${scratch}/room.json" "${scratch}/renamed.json" entry 1 1 2 2 --name "Renamed entrance")
run(0 inspect "${scratch}/renamed.json" --json)
string(JSON id GET "${last_output}" source rooms 0 id)
string(JSON name GET "${last_output}" source rooms 0 name)
if(NOT id STREQUAL "entry" OR NOT name STREQUAL "Renamed entrance")
  message(FATAL_ERROR "Rename lost stable ID or did not change name")
endif()
file(SHA256 "${scratch}/room.json" before)
run(2 room-set "${scratch}/room.json" "${scratch}/room.json" entry 2 1 2 2 --force --json)
string(JSON code GET "${last_output}" diagnostics 0 code)
if(NOT code STREQUAL "locked_position")
  message(FATAL_ERROR "Locked movement was not rejected for the expected reason")
endif()
run(2 paint "${scratch}/room.json" "${scratch}/room.json" 1 1 0 --force --json)
run(2 fill "${scratch}/room.json" "${scratch}/room.json" 0 0 0 --force --json)
run(2 room-remove "${scratch}/room.json" "${scratch}/room.json" entry --force --json)
file(SHA256 "${scratch}/room.json" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Failed edit modified the saved source")
endif()
run(0 room-lock "${scratch}/room.json" "${scratch}/unlocked.json" entry 0 0)
run(0 room-set "${scratch}/unlocked.json" "${scratch}/moved.json" entry 3 1 2 2)
run(0 room-remove "${scratch}/moved.json" "${scratch}/removed.json" entry)
run(0 paint "${scratch}/removed.json" "${scratch}/painted.json" 5 5 0)
run(0 fill "${scratch}/painted.json" "${scratch}/filled.json" 5 5 1)
run(0 inspect "${scratch}/filled.json" --json)
string(JSON row GET "${last_output}" source allowed_mask 5)
if(NOT row STREQUAL "111111111111")
  message(FATAL_ERROR "Fill did not restore the erased tile")
endif()
run(4 paint "${scratch}/filled.json" "${scratch}/room.json" 0 0 0 --json)
run(64 paint "${scratch}/mask.json" "${scratch}/never.json" 0 0 2)
run(64 room-lock "${scratch}/room.json" "${scratch}/never.json" entry -1 0)
run(64 mask "${scratch}/mask.json" "${scratch}/never.json" unknown 0 0 5 5)
run(2 paint "${scratch}/mask.json" "${scratch}/never.json" -1 0 0 --json)
if(EXISTS "${scratch}/never.json")
  message(FATAL_ERROR "Rejected command created its destination")
endif()
foreach(name mask ellipse l-shape room renamed unlocked moved removed painted filled)
  file(REMOVE "${scratch}/${name}.json")
endforeach()
message(STATUS "Geometry fixtures, CLI edits, diagnostics, and file preservation passed")
