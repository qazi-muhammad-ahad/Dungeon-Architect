cmake_policy(SET CMP0057 NEW)
function(run expected)
  execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${code}" STREQUAL "${expected}")
    string(SUBSTRING "${out}" 0 3000 excerpt)
    message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${code}\n${excerpt}\n${err}")
  endif()
  if("--json" IN_LIST ARGN AND NOT code STREQUAL "64" AND NOT err STREQUAL "")
    message(FATAL_ERROR "JSON command polluted stderr: ${err}")
  endif()
  set(last_output "${out}" PARENT_SCOPE)
  set(last_error "${err}" PARENT_SCOPE)
endfunction()
set(dir "${TEST_DIR}/pipeline-cli")
file(MAKE_DIRECTORY "${dir}")
string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef id)
set(output "${dir}/result with spaces-${id}.json")
set(small "${DATASETS}/pipeline/teaching.json")
set(large "${DATASETS}/pipeline/irregular-fortress.json")
file(SHA256 "${small}" small_hash)
file(SHA256 "${large}" large_hash)
run(0 --help)
if(NOT last_output MATCHES "dungeon_cli run" OR NOT last_output MATCHES "dungeon_cli export" OR NOT last_output MATCHES "cancel-file")
  message(FATAL_ERROR "Incomplete CLI help")
endif()
run(0 run "${small}" --json --output "${output}" --events 3)
set(first "${last_output}")
file(READ "${output}" exported)
if(NOT first STREQUAL exported)
  message(FATAL_ERROR "Export and stdout JSON differ")
endif()
string(JSON score GET "${exported}" result allocation total_score)
string(JSON spawn_count LENGTH "${exported}" result allocation actors)
string(JSON geometry_id GET "${exported}" result geometry id)
string(JSON dependency GET "${exported}" result allocation geometry_id)
string(JSON layout_id GET "${exported}" result layout id)
string(JSON layout_dependency GET "${exported}" result geometry room_layout_id)
string(JSON rows LENGTH "${exported}" result geometry layers floor)
if(NOT score EQUAL 14 OR NOT spawn_count EQUAL 3 OR NOT geometry_id STREQUAL dependency OR NOT layout_id STREQUAL layout_dependency OR NOT rows EQUAL 16)
  message(FATAL_ERROR "Pipeline lost full geometry, assignments or snapshot dependencies")
endif()
foreach(stage generation routing allocation)
  string(JSON count LENGTH "${exported}" stages ${stage} events)
  string(JSON status GET "${exported}" stages ${stage} outcome)
  if(count GREATER 3 OR NOT status STREQUAL "success")
    message(FATAL_ERROR "Stage trace bound or success missing")
  endif()
endforeach()
run(0 export "${small}" "${output}" --force --json --events 3)
if(NOT first STREQUAL last_output)
  message(FATAL_ERROR "run/export replay differs")
endif()
file(SHA256 "${output}" output_hash)
execute_process(COMMAND "${CLI}" run "${small}" --json --output "${output}" --force --events 3
  RESULT_VARIABLE raw_code OUTPUT_FILE "${dir}/raw-stdout-${id}.json" ERROR_VARIABLE raw_error)
file(SHA256 "${dir}/raw-stdout-${id}.json" stdout_hash)
file(SHA256 "${output}" raw_export_hash)
if(NOT raw_code EQUAL 0 OR NOT raw_error STREQUAL "" OR NOT stdout_hash STREQUAL raw_export_hash OR NOT output_hash STREQUAL raw_export_hash)
  message(FATAL_ERROR "Raw stdout and exported file bytes differ (including newlines)")
endif()
set(alias_source "${dir}/alias-source-${id}.json")
set(alias_target "${dir}/alias-target-${id}.json")
file(COPY_FILE "${small}" "${alias_source}")
file(CREATE_LINK "${alias_source}" "${alias_target}" RESULT link_status)
if(link_status STREQUAL "0")
  run(4 export "${alias_source}" "${alias_target}" --force --json)
  file(SHA256 "${alias_source}" alias_hash)
  if(NOT alias_hash STREQUAL small_hash)
    message(FATAL_ERROR "Alias check changed input bytes")
  endif()
endif()
run(4 run "${small}" --output "${output}" --json)
run(4 export "${small}" "${small}" --force --json)
run(4 export "${small}" "${dir}/missing-${id}/out.json" --json)
run(4 export "${small}" "${dir}" --force --json)
run(64 export "${small}")
run(64 run "${small}" --force)
run(64 run "${small}" --json --json)
run(64 run "${small}" --preview 0 0 161 80)
run(64 run "${small}" --preview -1 0 10 10)
run(2 run "${small}" --preview 24 0 10 10 --json)
run(64 run "${small}" --preview 0 0 10 10 --no-map)
run(0 run "${small}" --preview 16 4 8 8 --metrics)
if(NOT last_output MATCHES "Preview origin \\(16,4\\), 8x8" OR NOT last_output MATCHES "Allocation work:" OR NOT last_output MATCHES "Exact optimum.*score 14")
  message(FATAL_ERROR "Missing crop, metrics or allocation summary")
endif()
run(0 run "${small}" --no-map)
if(last_output MATCHES "Preview origin")
  message(FATAL_ERROR "--no-map ignored")
endif()
foreach(command generate route optimize)
  set(stage_output "${dir}/${command}-${id}.json")
  run(0 ${command} "${small}" --output "${stage_output}" --json --events 0)
  file(READ "${stage_output}" written)
  if(NOT written STREQUAL last_output)
    message(FATAL_ERROR "Stage export changed stdout payload")
  endif()
endforeach()
run(0 run "${small}" --budget 2 --seed 42 --rooms 2 --corridor-width 1 --json --events 0)
string(JSON score GET "${last_output}" result allocation total_score)
string(JSON width GET "${last_output}" result source_project source settings corridor_width)
if(NOT score EQUAL 9 OR NOT width EQUAL 1)
  message(FATAL_ERROR "Effective overrides missing from result/replay source")
endif()
run(0 run "${large}" --json --events 0)
set(large_first "${last_output}")
string(JSON count LENGTH "${last_output}" result layout rooms)
string(JSON active LENGTH "${last_output}" stages allocation pack_bit_order)
if(NOT count EQUAL 16 OR NOT active EQUAL 14)
  message(FATAL_ERROR "Realistic fixture lost rooms or inventory")
endif()
run(0 run "${large}" --json --events 0)
if(NOT large_first STREQUAL last_output)
  message(FATAL_ERROR "Realistic full pipeline is not deterministic")
endif()
# Exercise failures through run/export; none may replace the accepted output.
file(WRITE "${dir}/bad-${id}.json" "{broken")
run(2 export "${dir}/bad-${id}.json" "${output}" --force --json)
run(4 run "${dir}/absent-${id}.json" --json)
run(3 export "${DATASETS}/allocation/unsupported-15.json" "${output}" --force --json --events 0)
run(7 export "${DATASETS}/generation/rectangle.json" "${output}" --force --attempts 1 --json --events 0)
string(JSON failed GET "${last_output}" failed_stage)
if(NOT failed STREQUAL "room_layout")
  message(FATAL_ERROR "Generation failure stage lost")
endif()
run(7 export "${DATASETS}/routing/narrow-neck-width2.json" "${output}" --force --json --events 0)
string(JSON failed GET "${last_output}" failed_stage)
if(NOT failed STREQUAL "walkable_geometry")
  message(FATAL_ERROR "Routing failure stage lost")
endif()
run(5 export "${DATASETS}/allocation/standard-14.json" "${output}" --force --work 10000000 --json --events 0)
string(JSON kind TYPE "${last_output}" result)
string(JSON optimal GET "${last_output}" optimal)
if(NOT kind STREQUAL "NULL" OR optimal)
  message(FATAL_ERROR "Failed combined run exposed partial/optimal result")
endif()
set(marker "${dir}/cancel-${id}")
file(WRITE "${marker}" "cancel")
run(6 export "${small}" "${output}" --force --cancel-file "${marker}" --json --events 0)
string(JSON kind TYPE "${last_output}" result)
if(NOT kind STREQUAL "NULL")
  message(FATAL_ERROR "Cancelled run exposed a partial result")
endif()
run(4 run "${small}" --cancel-file "${small}" --json)
file(SHA256 "${output}" after)
file(SHA256 "${small}" small_after)
file(SHA256 "${large}" large_after)
if(NOT after STREQUAL output_hash OR NOT small_after STREQUAL small_hash OR NOT large_after STREQUAL large_hash)
  message(FATAL_ERROR "Failure overwrote result or pipeline changed a source")
endif()
file(GLOB leftovers "${dir}/*.tmp.*")
if(leftovers)
  message(FATAL_ERROR "Atomic export leaked temporary files")
endif()
message(STATUS "Full CLI pipeline/export/replay/cancellation/failure preservation passed")
