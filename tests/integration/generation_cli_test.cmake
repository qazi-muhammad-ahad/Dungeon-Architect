include("${CMAKE_CURRENT_LIST_DIR}/../semantic_report.cmake")
function(run expected)
  execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${code}" STREQUAL "${expected}")
    message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${code}\n${out}\n${err}")
  endif()
  set(last_output "${out}" PARENT_SCOPE)
endfunction()
foreach(name rectangle l-shape backtracking fixed-hole fixed-single-leaf)
  set(file "${DATASETS}/${name}.json")
  file(SHA256 "${file}" before)
  run(0 generate "${file}" --json --events 8)
  set(first "${last_output}")
  string(JSON actual LENGTH "${first}" layout rooms)
  file(READ "${file}" source)
  string(JSON requested GET "${source}" source settings room_count)
  if(NOT actual EQUAL requested)
    message(FATAL_ERROR "Generated count is not exact")
  endif()
  run(0 generate "${file}" --json --events 8)
  expect_semantic_equal("${first}" "${last_output}" "Identical source/seed changed generated semantics")
  file(SHA256 "${file}" after)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "Generation changed its input")
  endif()
endforeach()
run(0 generate "${DATASETS}/fixed-hole.json" --events 0)
if(NOT last_output MATCHES "4 / 4 rooms" OR NOT last_output MATCHES "use route to build and verify walkable floor")
  message(FATAL_ERROR "Human output is missing exact-count or stage information")
endif()
run(7 generate "${DATASETS}/rectangle.json" --attempts 1 --json)
string(JSON type TYPE "${last_output}" layout)
if(NOT type STREQUAL "NULL")
  message(FATAL_ERROR "Failed generation exposed a partial result")
endif()
run(7 generate "${DATASETS}/rectangle.json" --work 1 --json)
run(64 generate "${DATASETS}/rectangle.json" --seed -1)
run(64 generate "${DATASETS}/rectangle.json" --events 4097)
run(64 generate "${DATASETS}/rectangle.json" --attempts 0)
run(64 generate "${DATASETS}/rectangle.json" --unknown 1)
message(STATUS "Generation CLI deterministic output, exact counts, limits, and unchanged source passed")
