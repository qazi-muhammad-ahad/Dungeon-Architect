include("${CMAKE_CURRENT_LIST_DIR}/../semantic_report.cmake")
set(commands validate generate route optimize run)
set(operation 0)
foreach(command IN LISTS commands)
  math(EXPR operation "${operation}+1")
  execute_process(COMMAND "${CALLER}" "${FIXTURE}" "${operation}" RESULT_VARIABLE code OUTPUT_VARIABLE api ERROR_VARIABLE errors)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "C caller ${command}: ${code} ${errors}")
  endif()
  execute_process(COMMAND "${CLI}" "${command}" "${FIXTURE}" --json RESULT_VARIABLE code OUTPUT_VARIABLE cli)
  remove_timing("${api}" api_semantic)
  remove_timing("${cli}" cli_semantic)
  if(NOT code EQUAL 0 OR NOT api_semantic STREQUAL cli_semantic)
    message(FATAL_ERROR "CLI/C API ${command} mismatch")
  endif()
endforeach()
